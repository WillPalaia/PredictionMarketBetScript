# Kalshi Environment: "production" (recommended for live stadium quotes) or "demo"
KALSHI_ENV=production

# Simulation Mode: true (safe test mode with real quotes & simulated fills) or false (real money orders)
SIMULATION_MODE=true

# Kalshi API Authentication (Required for real orders, obtain from Kalshi Account -> API Keys)
# 1. API Key ID
KALSHI_KEY_ID=your_kalshi_key_id_here
# 2. Path to your downloaded RSA private key (.pem or .key)
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Default Courtside Betting Controls
DEFAULT_BET_AMOUNT_DOLLARS=1.00
DEFAULT_PRICE_BUFFER_CENTS=0.03
POLL_INTERVAL_SECONDS=0.15

# Server Network Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
